# Copy to .env (same folder) and fill in. .env is gitignored and must never be committed.
# Demo only: synthetic data only. SYNTHETIC_ONLY cannot be turned off.

# Required. At least 32 characters. Derives resume codes.
# Generate one once with: python -c "import secrets; print(secrets.token_hex(32))"
# Keep it the same after that. Resume codes are derived from it, so changing it makes
# every resume code already given out stop working.
APP_SECRET=

# Gemini API key (Google AI Studio). Read by the app's settings and passed to the
# Gemini client explicitly. Without it (or left blank), no model is called: buttons
# work and typed replies get "Typing is not working right now."
GOOGLE_API_KEY=

# Optional overrides (defaults shown).
# GEMINI_MODEL=gemini-3.5-flash-lite
# REGION=US
# LLM_DEADLINE_S=12
# LLM_HEDGE_AFTER_S=4
# DATABASE_URL=sqlite:///<home>/.intake-v2/intake.db
